<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Thank You!</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      font-family: 'Segoe UI', sans-serif;
      background-color: #e0fff5;
      color: #003c3c;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: start;
      min-height: 100vh;
      text-align: center;
    }

    header {
      background-color: #00d4aa;
      width: 100%;
      padding: 40px 20px;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      animation: fadeInDown 1s ease-in-out;
    }

    header h1 {
      margin: 0;
      font-size: 2.8rem;
      color: white;
    }

    header p {
      margin-top: 10px;
      font-size: 1.2rem;
      color: #eafffa;
    }

    .content {
      padding: 30px 20px;
      animation: fadeIn 1.3s ease;
      max-width: 500px;
    }

    .thank-you {
      font-size: 1.4rem;
      margin-bottom: 20px;
    }

    .tiktok-handle {
      font-size: 1.1rem;
      color: #007d6c;
      margin-bottom: 20px;
    }

    .image-center img {
      width: 100%;
      max-width: 300px;
      border-radius: 15px;
      margin: 25px auto;
      box-shadow: 0 0 12px rgba(0, 0, 0, 0.2);
    }

    .button {
      margin: 10px auto 20px;
      background-color: #00c89c;
      color: white;
      padding: 12px 25px;
      border: none;
      border-radius: 30px;
      font-size: 1rem;
      cursor: pointer;
      transition: background-color 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }

    .button:hover {
      background-color: #00b08a;
    }

    audio {
      display: none;
    }

    @keyframes fadeInDown {
      from { opacity: 0; transform: translateY(-30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</head>
<body>

  <header>
    <h1>Thank You!</h1>
    <p>For following my TikTok account 🎉</p>
  </header>

  <div class="content">
    <div class="thank-you">
      Your support really means a lot! I’ll keep making great content just for you.
    </div>
    <div class="tiktok-handle">
      Stay tuned for more! 💚
    </div>

    <div class="image-center">
      <img src="anime-red.jpg" alt="Anime Girl with Red Hair" />
    </div>

    <a href="https://www.tiktok.com/@_yaziz?_t=ZS-8xsefpRNi6B&_r=1" target="_blank" class="button">Visit My TikTok</a>
    <br />
    <button class="button" onclick="document.getElementById('bg-music').play()">🎵 Play Music</button>

    <audio id="bg-music">
      <source src="https://files.freemusicarchive.org/storage-freemusicarchive-org/music/ccCommunity/Lobo_Loco/Animation/Flying_Horses_ID_1235.mp3" type="audio/mpeg">
      Your browser does not support the audio tag.
    </audio>
  </div>

</body>
</html>
